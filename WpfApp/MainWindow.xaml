<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
                
            <TextBox  x:Name="SearchTextBox" Width="400"/>
                
            <Button   x:Name="NameSortButton" Content="Sort by name"/>
            <Button x:Name="RatingSortButton" Content="Sort by rating"/>

            <Button  x:Name="HomeButton" Content="home"/>
                
            </StackPanel>
        <ListBox Grid.Row="1" x:Name="FilmListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <Image Source="{Binding Cover}" Width="250"/>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="20" MaxWidth="250" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>
                        <TextBlock Text="{Binding StartDate.Year, StringFormat=Дата выхода: {0}}"/>
                        <TextBlock Text="{Binding AgeRating, StringFormat=Возрастной рейтинг: {0}+}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Window>
