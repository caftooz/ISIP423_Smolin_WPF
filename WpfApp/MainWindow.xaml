<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="1" Margin="10" x:Name="SearchTextBox" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Margin="10"  Width="20" Height="20" x:Name="NameSortButton" Content="Sort by name"/>
                <Button  Width="20" Height="20" x:Name="RatingSortButton" Content="Sort by rating"/>
            </StackPanel>

            <Button Grid.Column="4" Margin="10" x:Name="HomeButton" Content="home"/>

        </Grid>
                
        <ListBox Grid.Row="1" x:Name="FilmListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <Image Source="{Binding Cover}" Width="250"/>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="20" MaxWidth="250" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>
                        <TextBlock Text="{Binding StartDate.Year, StringFormat=Дата выхода: {0}}"/>
                        <TextBlock Text="{Binding AgeRating, StringFormat=Возрастной рейтинг: {0}+}"/>
                    </StackPanel>
                </DataTemplate>
                        
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Window>
