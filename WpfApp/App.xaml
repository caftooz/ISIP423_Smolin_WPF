<Application x:Class="WpfApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfApp"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        
        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="5,0,0,2"/>
        </Style>

        <Style x:Key="SeatStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="RootGrid" Width="38" Height="38" Margin="2">

                            <Border x:Name="SeatBorder" 
                            Background="#333333" 
                            CornerRadius="6" 
                            BorderBrush="#555555" 
                            BorderThickness="1.5"/>

                            <TextBlock Text="{Binding Number}"  x:Name="NumberText"
                               Foreground="Gray" 
                               FontSize="11" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SeatBorder" Property="Background" Value="#555555"/>
                                <Setter TargetName="SeatBorder" Property="BorderBrush" Value="#888888"/>
                                <Setter TargetName="NumberText" Property="Foreground" Value="Gray"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SeatBorder" Property="Background" Value="#E50914"/>
                                <Setter TargetName="SeatBorder" Property="BorderBrush" Value="#FF4D4D"/>
                                <Setter TargetName="NumberText" Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SeatBorder" Property="Background" Value="#151515"/>
                                <Setter TargetName="SeatBorder" Property="BorderBrush" Value="#000000"/>
                                <Setter TargetName="NumberText" Property="Foreground" Value="Gray"/>
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
