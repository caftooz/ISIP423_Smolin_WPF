<UserControl x:Class="WpfApp.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">

            <TextBlock Text="РОГАЛИК ГАМЕ"
                       FontSize="42" FontWeight="Bold"
                       Foreground="#e94560"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Roguelike RPG"
                       FontSize="18"
                       Foreground="#a0a0c0"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,60"/>

            <Button Content="НАЧАТЬ ИГРУ"
                    Command="{Binding StartGameCommand}"
                    FontSize="20" FontWeight="Bold"
                    Foreground="White"
                    Height="56" Width="260"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#e94560"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#c73652"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Text="Налево поёдешь меч найдешь... Направо пойдешь смерть отыщищ ав ав"
                       FontSize="13" Foreground="#555577"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>

</UserControl>
