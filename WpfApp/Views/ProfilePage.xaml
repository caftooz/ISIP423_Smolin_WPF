<Page x:Class="WpfApp.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      Title="ProfilePage">
    <Page.DataContext><vm:ProfileViewModel/></Page.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Header}">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Назад" Style="{StaticResource MainButton}" Command="{Binding BackCommand}" Margin="0,0,15,0"/>
                        <TextBlock Style="{StaticResource SubtitleText}" VerticalAlignment="Center">
                            <Run Text="{Binding CurrentUser.LastName, Mode=OneWay}"/>
                            <Run Text=" "/><Run Text="{Binding CurrentUser.FirstName, Mode=OneWay}"/>
                            <Run Text=" "/><Run Text="{Binding CurrentUser.Patronymic, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding CurrentUser.PhoneNumber}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="Выйти" Style="{StaticResource MainButton}" HorizontalAlignment="Right" Command="{Binding LogoutCommand}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,8,0,0">
            <Button Content="Заказы" Style="{StaticResource MainButton}" Command="{Binding ShowOrdersCommand}"/>
            <Button Content="Записи" Style="{StaticResource MainButton}" Command="{Binding ShowAppointmentsCommand}"/>
        </StackPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding Orders}" Style="{StaticResource MainListBox}" Margin="20,8"
                 Visibility="{Binding ShowOrders, Converter={StaticResource BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Width="580">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                                    <Run Text="Заказ #"/><Run Text="{Binding Id, Mode=OneWay}"/>
                                    <Run Text=" от "/><Run Text="{Binding OrderDateTime, StringFormat='dd.MM.yyyy', Mode=OneWay}"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding OrderProducts}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CaptionText}">
                                                <Run Text="{Binding Products.Name, Mode=OneWay}"/><Run Text=" x"/><Run Text="{Binding Quantity, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource PriceText}" Text="{Binding TotalCost, StringFormat={}{0:0.00} ₽}"/>
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding PaymentMethods.Name}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox Grid.Row="2" ItemsSource="{Binding Appointments}" Style="{StaticResource MainListBox}" Margin="20,8"
                 Visibility="{Binding ShowAppointments, Converter={StaticResource BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Width="580">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Services.Name}"/>
                                <TextBlock Style="{StaticResource CaptionText}">
                                    <Run Text="{Binding Users1.LastName, Mode=OneWay}"/><Run Text=" "/>
                                    <Run Text="{Binding Users1.FirstName, Mode=OneWay}"/><Run Text=" "/>
                                    <Run Text="{Binding Users1.Patronymic, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding AppointmentDateTime, StringFormat='dd.MM.yyyy'}" HorizontalAlignment="Right"/>
                                <TextBlock Style="{StaticResource BodyText}" HorizontalAlignment="Right">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:00}:{1:00}">
                                            <Binding Path="AppointmentDateTime.Hour"/>
                                            <Binding Path="AppointmentDateTime.Minute"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
