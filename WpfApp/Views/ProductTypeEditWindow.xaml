<Window x:Class="WpfApp.Views.ProductTypeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        Title="Тип товара" Height="180" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:SimpleNameEditViewModel/>
    </Window.DataContext>
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource LabelText}" Text="Название"/>
        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding Name}" Margin="0,0,0,12"/>
        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Отмена" Style="{StaticResource MainButton}" Command="{Binding CancelCommand}"/>
            <Button Content="Сохранить" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
