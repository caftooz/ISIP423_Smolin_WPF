<Window x:Class="WpfApp.Views.RescheduleAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        Title="Перенос записи" Height="240" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:RescheduleViewModel/>
    </Window.DataContext>
    <StackPanel Margin="20">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,4,0">
                <TextBlock Style="{StaticResource LabelText}" Text="Дата"/>
                <DatePicker Style="{StaticResource MainDatePicker}" SelectedDate="{Binding SelectedDate}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Style="{StaticResource LabelText}" Text="Время (чч:мм)"/>
                <TextBox Style="{StaticResource MainTextBox}" Text="{Binding TimeText}"/>
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Style="{StaticResource MainButton}" Command="{Binding CancelCommand}"/>
            <Button Content="Перенести" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
