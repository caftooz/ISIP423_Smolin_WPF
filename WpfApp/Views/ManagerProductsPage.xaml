<Page x:Class="WpfApp.Views.ManagerProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      Title="ManagerProductsPage">
    <Page.DataContext>
        <vm:ManagerProductsListViewModel/>
    </Page.DataContext>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Style="{StaticResource MainTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,5,0"/>
            <Button Content="добавить товар" Style="{StaticResource AccentButton}" Command="{Binding AddCommand}"/>
        </StackPanel>
        <DataGrid Style="{StaticResource MainDataGrid}" Grid.Row="1" ItemsSource="{Binding Items}"
                 >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:0.00}}" Width="80"/>
                <DataGridTextColumn Header="Скидка" Binding="{Binding PercentageDiscount, StringFormat={}{0}%}" Width="60"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating, StringFormat={}{0:0.0}}" Width="60"/>
                <DataGridTextColumn Header="Статус" Width="80">
                    <DataGridTextColumn.Binding>
                        <Binding Path="IsFrozen" Converter="{StaticResource InverseBoolToFrozenConverter}"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Действия" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="изменить" Style="{StaticResource MainButton}" Margin="2"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
