<Window x:Class="WpfApp.Views.ScheduleAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        Title="Добавление записи расписания" Height="240" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:ScheduleAddViewModel/>
    </Window.DataContext>
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource LabelText}" Text="Услуга"/>
        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding ServiceName}" IsReadOnly="True" Margin="0,0,0,6"/>
        <TextBlock Style="{StaticResource LabelText}" Text="День недели"/>
        <ComboBox Style="{StaticResource MainComboBox}" ItemsSource="{Binding Days}"
                  SelectedItem="{Binding SelectedDay}" DisplayMemberPath="Name" Margin="0,0,0,6"/>
        <TextBlock Style="{StaticResource LabelText}" Text="Время (чч:мм)"/>
        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding TimeText}" Margin="0,0,0,12"/>
        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Отмена" Style="{StaticResource MainButton}" Command="{Binding CancelCommand}"/>
            <Button Content="Добавить" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
