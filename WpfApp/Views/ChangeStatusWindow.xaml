<Window x:Class="ServiceDesk.Views.ChangeStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить статус"
        Height="300" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}">
    <Border Margin="20" Background="White" CornerRadius="8"
            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
        <StackPanel Margin="24">
            <TextBlock x:Name="TxtRequestNum"
                       FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource TextDarkBrush}"
                       Margin="0,0,0,16"/>
            <TextBlock Text="Выберите новый статус:" Style="{StaticResource FormLabel}"/>
            <ComboBox x:Name="CmbStatus" Style="{StaticResource ComboStyle}" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource NeutralButton}"
                        Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button Content="Применить" Style="{StaticResource SuccessButton}"
                        Click="BtnApply_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
