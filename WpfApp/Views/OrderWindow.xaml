<Window x:Class="WpfApp.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" Height="350" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock Text="Товары в заказе:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ListBox x:Name="ItemsList" Height="120" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Итого:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TotalBlock" Grid.Column="1" FontWeight="Bold" FontSize="16"/>
        </Grid>

        <TextBlock Text="Способ оплаты"/>
        <ComboBox x:Name="PayCombo" DisplayMemberPath="Name" Margin="0,0,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="100" Margin="0,0,5,0" Click="Cancel_Click"/>
            <Button Content="Оформить заказ" Width="120" Click="Order_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
