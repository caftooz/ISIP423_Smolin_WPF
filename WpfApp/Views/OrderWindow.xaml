<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="WpfApp.Views.OrderWindow"
        Title="Оформление заказа" Height="450" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:OrderWindowViewModel/>
    </Window.DataContext>
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource LabelText}" Text="Дата получения"/>
        <DatePicker Style="{StaticResource MainDatePicker}" SelectedDate="{Binding ReceivedDate, Mode=OneWay}" DisplayDateStart="{Binding MinDate, Mode=OneWay}" DisplayDateEnd="{Binding MaxDate, Mode=OneWay}" Margin="0,0,0,8"/>

        <TextBlock Style="{StaticResource LabelText}" Text="Способ оплаты"/>
        <ComboBox Style="{StaticResource MainComboBox}" ItemsSource="{Binding PaymentMethods}"
                  SelectedItem="{Binding SelectedPayment}" DisplayMemberPath="Name" Margin="0,0,0,12"/>

        <ListBox ItemsSource="{Binding ItemLines}" Style="{StaticResource MainListBox}"
                 Height="130" BorderThickness="1" BorderBrush="{StaticResource MediumGrayBrush}" Margin="0,0,0,10" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2" Width="400">
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding PriceLine}" HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel HorizontalAlignment="Right" Margin="0,0,0,5">
            <TextBlock Style="{StaticResource BodyText}"><Run Text="Товары:  "/><Run Text="{Binding TotalPrice, Mode=OneWay, StringFormat=\{0:N0\} ₽}"/></TextBlock>
            <TextBlock Style="{StaticResource BodyText}"><Run Text="Скидка:  "/><Run Text="{Binding DiscountAmount, Mode=OneWay, StringFormat=\{0:N0\} ₽}"/></TextBlock>
            <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0"><Run Text="ИТОГО:  "/><Run Text="{Binding FinalPrice, Mode=OneWay, StringFormat=\{0:N0\} ₽}"/></TextBlock>
        </StackPanel>

        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

        <Button Content="Оформить заказ" Style="{StaticResource AccentButton}"
                HorizontalAlignment="Center" Padding="30,8" Margin="0,10,0,0"
                Command="{Binding PlaceOrderCommand}"/>
    </StackPanel>
</Window>
