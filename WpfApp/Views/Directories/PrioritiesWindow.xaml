<Window x:Class="ServiceDesk.Views.Directories.PrioritiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справочник: Приоритеты"
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LightBgBrush}">
    <Border Margin="16" Background="White" CornerRadius="8"
            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
        <DockPanel Margin="20">
            <TextBlock DockPanel.Dock="Top" Text="Приоритеты заявок"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextDarkBrush}"
                       Margin="0,0,0,16"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="+ Добавить" Style="{StaticResource AccentButton}"
                        Margin="0,0,8,0" Click="BtnAdd_Click"/>
                <Button Content="✏ Изменить" Style="{StaticResource NeutralButton}"
                        Margin="0,0,8,0" Click="BtnEdit_Click"/>
                <Button Content="🗑 Удалить" Style="{StaticResource DangerButton}"
                        Click="BtnDelete_Click"/>
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="Закрыть"
                    Style="{StaticResource NeutralButton}"
                    HorizontalAlignment="Right" Margin="0,10,0,0"
                    Click="BtnClose_Click"/>
            <DataGrid x:Name="Grid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"       Binding="{Binding Id}"    Width="50"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}"  Width="*"/>
                    <DataGridTextColumn Header="Уровень"  Binding="{Binding Level}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</Window>
