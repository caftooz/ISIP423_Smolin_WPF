<Page x:Class="WpfApp.Views.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Views"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">

    <Page.DataContext>
        <vm:CartViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="1" ItemsSource="{Binding Items}"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="210" Margin="5">
                        <StackPanel>
                            <Image Source="{Binding Product.Image}" Height="150" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:0.00} ₽}" Foreground="Red"/>
                            <TextBlock Text="{Binding Price, StringFormat={}{0:0.00} ₽}"
                       Visibility="{Binding Product.ShowDiscount, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding Product.Name}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="🗑" Command="{Binding RemoveCommand}"/>
                                <Button Content="−"  Command="{Binding DecreaseCommand}"/>
                                <TextBlock Text="{Binding Quantity}" Margin="10,0" VerticalAlignment="Center"/>
                                <Button Content="+"  Command="{Binding IncreaseCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Width="500"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Border Grid.Column="2">
            <StackPanel Margin="10">
                <TextBlock Text="{Binding TotalPrice, StringFormat=Товары: {0:0.00} ₽}"/>
                <TextBlock Text="{Binding DiscountAmount, StringFormat=Скидка: {0:0.00} ₽}"/>
                <TextBlock Text="{Binding FinalPrice, StringFormat=Итого: {0:0.00} ₽}"/>
                <Button Content="Оформить заказ" Margin="0,10,0,0" Command="{Binding CheckoutCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
