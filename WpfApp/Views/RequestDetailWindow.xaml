<Window x:Class="ServiceDesk.Views.RequestDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка заявки"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource LightBgBrush}">

    <Border Margin="18" Background="White" CornerRadius="8"
            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
        <DockPanel Margin="24">

            <!-- Шапка -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtNumber"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <Border x:Name="BadgePriority"
                            CornerRadius="4" Margin="12,0,0,0"
                            Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPriority"
                                   FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Border x:Name="BadgeStatus"
                            CornerRadius="4" Margin="6,0,0,0"
                            Padding="10,3" Background="#DFE6E9" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatus"
                                   FontSize="11" Foreground="{StaticResource TextDarkBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TxtCreated"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Кнопка закрытия -->
            <Button DockPanel.Dock="Bottom"
                    Content="Закрыть"
                    Style="{StaticResource NeutralButton}"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Click="BtnClose_Click"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Секция: Клиент -->
                    <TextBlock Text="КЛИЕНТ" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <Border Background="{StaticResource LightBgBrush}"
                            CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ФИО" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtClientName"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDarkBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Телефон" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtClientPhone"
                                           FontSize="13"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Секция: Техника -->
                    <TextBlock Text="ТЕХНИКА" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <Border Background="{StaticResource LightBgBrush}"
                            CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Тип техники" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtEquip"
                                           FontSize="13"
                                           Foreground="{StaticResource TextDarkBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Исполнитель" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtExecutor"
                                           FontSize="13"
                                           Foreground="{StaticResource TextDarkBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Секция: Описание -->
                    <TextBlock Text="ОПИСАНИЕ НЕИСПРАВНОСТИ" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <Border Background="#FFFBF0"
                            BorderBrush="#F39C12" BorderThickness="0,0,0,3"
                            CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtFault"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDarkBrush}"
                                   LineHeight="20"/>
                    </Border>

                    <!-- Секция: Комментарий по ремонту -->
                    <TextBlock Text="КОММЕНТАРИЙ ПО РЕМОНТУ" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <Border Background="#F0FFF4"
                            BorderBrush="#27AE60" BorderThickness="0,0,0,3"
                            CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtComment"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDarkBrush}"
                                   FontStyle="Italic"/>
                    </Border>

                    <!-- Дата завершения -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Дата завершения: " Style="{StaticResource FormLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCompletion"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDarkBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
