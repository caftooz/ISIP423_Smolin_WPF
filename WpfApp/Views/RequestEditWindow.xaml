<Window x:Class="ServiceDesk.Views.RequestEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заявка"
        Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}">

    <Border Margin="20" Background="White" CornerRadius="8"
            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
        <DockPanel Margin="24">

            <!-- Заголовок -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock x:Name="TxtTitle" Text="Новая заявка"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}"/>
                <TextBlock x:Name="TxtNumber" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена"
                        Style="{StaticResource NeutralButton}"
                        Margin="0,0,10,0"
                        Click="BtnCancel_Click"/>
                <Button Content="Сохранить"
                        Style="{StaticResource AccentButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>

            <!-- Форма -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Клиент -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="ФИО клиента *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtClientName" Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <!-- Телефон -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Телефон клиента" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtClientPhone" Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <!-- Тип техники -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Тип техники" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="CmbEquipType" Style="{StaticResource ComboStyle}"/>
                    </StackPanel>

                    <!-- Приоритет -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Приоритет" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="CmbPriority" Style="{StaticResource ComboStyle}"/>
                    </StackPanel>

                    <!-- Статус -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Статус" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="CmbStatus" Style="{StaticResource ComboStyle}"/>
                    </StackPanel>

                    <!-- Исполнитель -->
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Исполнитель" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="CmbExecutor" Style="{StaticResource ComboStyle}"/>
                    </StackPanel>

                    <!-- Дата завершения -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Дата завершения" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="DpCompletion"
                                    FontSize="13" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <!-- Описание -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                        <TextBlock Text="Описание неисправности *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtFault"
                                 Style="{StaticResource InputStyle}"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <!-- Комментарий -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                        <TextBlock Text="Комментарий по ремонту" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtComment"
                                 Style="{StaticResource InputStyle}"
                                 Height="70"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
