<Window x:Class="WpfApp.Views.NewAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        Title="Новая запись клиента" Height="560" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:NewAppointmentViewModel/>
    </Window.DataContext>
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource LabelText}" Text="Клиент (поиск по ФИО или телефону)"/>
        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
        <ListBox ItemsSource="{Binding FilteredClients}" SelectedItem="{Binding SelectedClient}"
                 Style="{StaticResource MainListBox}" Height="80" BorderThickness="1"
                 BorderBrush="{StaticResource MediumGrayBrush}" Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource BodyText}">
                        <Run Text="{Binding LastName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding FirstName, Mode=OneWay}"/>
                        <Run Text=" - "/><Run Text="{Binding PhoneNumber, Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Style="{StaticResource LabelText}" Text="Услуга"/>
        <ComboBox Style="{StaticResource MainComboBox}" ItemsSource="{Binding AllServices}"
                  SelectedItem="{Binding SelectedService}" DisplayMemberPath="Name" Margin="0,0,0,6"/>

        <TextBlock Style="{StaticResource LabelText}" Text="Мастер"/>
        <ComboBox Style="{StaticResource MainComboBox}" ItemsSource="{Binding AvailableMasters}"
                  SelectedItem="{Binding SelectedMasterService}" Margin="0,0,0,6">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock><Run Text="{Binding Users.LastName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Users.FirstName, Mode=OneWay}"/></TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,4,0">
                <TextBlock Style="{StaticResource LabelText}" Text="Дата"/>
                <DatePicker Style="{StaticResource MainDatePicker}" SelectedDate="{Binding SelectedDate}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Style="{StaticResource LabelText}" Text="Время (чч:мм)"/>
                <TextBox Style="{StaticResource MainTextBox}" Text="{Binding TimeText}"/>
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource LabelText}" Text="Способ оплаты"/>
        <ComboBox Style="{StaticResource MainComboBox}" ItemsSource="{Binding PaymentMethods}"
                  SelectedItem="{Binding SelectedPayment}" DisplayMemberPath="Name" Margin="0,0,0,6"/>

        <TextBlock Style="{StaticResource LabelText}" Text="Комментарий"/>
        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding Comment}" Margin="0,0,0,8"/>

        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Отмена" Style="{StaticResource MainButton}" Command="{Binding CancelCommand}"/>
            <Button Content="Записать" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
