<Page x:Class="WpfApp.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      Title="LoginPage">
    <Page.DataContext>
        <vm:LoginViewModel/>
    </Page.DataContext>
    <Grid>
        <Border Style="{StaticResource FormBorder}" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <Button Content="Назад" Style="{StaticResource MainButton}" HorizontalAlignment="Left" Command="{Binding BackCommand}"/>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding PhoneNumber}" Margin="0,8,0,4"
                           Visibility="{Binding ShowPhoneStep, Converter={StaticResource InverseBoolToVisibility}}"/>

                <!-- Step 1: Phone -->
                <StackPanel Visibility="{Binding ShowPhoneStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource LabelText}" Text="Номер телефона"/>
                    <TextBox x:Name="PhoneBox" Style="{StaticResource MainTextBox}" MaxLength="18" TextChanged="PhoneBox_TextChanged"/>
                    <Button Content="Продолжить" Style="{StaticResource AccentButton}" Width="140" Margin="0,10,0,0" Command="{Binding ContinueCommand}"/>
                </StackPanel>

                <!-- Step 2a: Login -->
                <StackPanel Visibility="{Binding ShowLoginStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource LabelText}" Text="Пароль"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource MainPasswordBox}" PasswordChanged="PasswordBox_PasswordChanged"/>
                    <Button Content="Войти" Style="{StaticResource AccentButton}" Width="140" Margin="0,10,0,0" Command="{Binding LoginCommand}"/>
                </StackPanel>

                <!-- Step 2b: Register -->
                <StackPanel Visibility="{Binding ShowRegisterStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource LabelText}" Text="ФИО"/>
                    <TextBox Style="{StaticResource MainTextBox}" Text="{Binding FirstName}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource LabelText}" Text="Фамилия"/>
                    <TextBox Style="{StaticResource MainTextBox}" Text="{Binding LastName}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource LabelText}" Text="Отчество"/>
                    <TextBox Style="{StaticResource MainTextBox}" Text="{Binding Patronymic}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource LabelText}" Text="Придумайте пароль"/>
                    <PasswordBox x:Name="RegPasswordBox" Style="{StaticResource MainPasswordBox}" PasswordChanged="RegPasswordBox_PasswordChanged"/>
                    <Button Content="Создать аккаунт" Style="{StaticResource AccentButton}" Width="160" Margin="0,10,0,0" Command="{Binding RegisterCommand}"/>
                </StackPanel>

                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>
