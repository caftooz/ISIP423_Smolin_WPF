<Window x:Class="WpfApp.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="480" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock Text="Название"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,8"/>

        <TextBlock Text="Описание"/>
        <TextBox x:Name="DescBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,5,0">
                <TextBlock Text="Цена"/>
                <TextBox x:Name="PriceBox"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Скидка %"/>
                <TextBox x:Name="DiscountBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Тип товара"/>
        <ComboBox x:Name="TypeCombo" DisplayMemberPath="Name" Margin="0,0,0,8"/>

        <TextBlock Text="Производитель"/>
        <ComboBox x:Name="ManufCombo" DisplayMemberPath="Name" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Статус" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <CheckBox x:Name="FrozenCheck" Content="заблокирован"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="80" Margin="0,0,5,0" Click="Cancel_Click"/>
            <Button Content="Сохранить" Width="80" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
