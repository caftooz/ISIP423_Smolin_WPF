<Window x:Class="WpfApp.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        Title="Товар" Height="500" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:ProductEditWindowViewModel/>
    </Window.DataContext>
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource LabelText}" Text="Название"/>
        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding Name}" Margin="0,0,0,6"/>

        <TextBlock Style="{StaticResource LabelText}" Text="Описание"/>
        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding Description}" Height="60"
                 TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,6"/>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,4,0">
                <TextBlock Style="{StaticResource LabelText}" Text="Цена"/>
                <TextBox Style="{StaticResource MainTextBox}" Text="{Binding PriceText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Style="{StaticResource LabelText}" Text="Скидка %"/>
                <TextBox Style="{StaticResource MainTextBox}" Text="{Binding DiscountText}"/>
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource LabelText}" Text="Тип товара"/>
        <ComboBox Style="{StaticResource MainComboBox}" ItemsSource="{Binding ProductTypes}"
                  SelectedItem="{Binding SelectedType}" DisplayMemberPath="Name" Margin="0,0,0,6"/>

        <TextBlock Style="{StaticResource LabelText}" Text="Производитель"/>
        <ComboBox Style="{StaticResource MainComboBox}" ItemsSource="{Binding Manufacturers}"
                  SelectedItem="{Binding SelectedManufacturer}" DisplayMemberPath="Name" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource BodyText}" Text="Статус" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsNotFrozen}"/>
            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock.Text>
                    <Binding Path="IsNotFrozen" Converter="{StaticResource BoolToFrozenConverter}"/>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>

        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Отмена" Style="{StaticResource MainButton}" Command="{Binding CancelCommand}"/>
            <Button Content="Сохранить" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
