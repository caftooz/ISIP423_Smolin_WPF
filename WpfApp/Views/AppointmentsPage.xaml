<Page x:Class="WpfApp.Views.AppointmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Views"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentsPage">

    <Page.DataContext>
        <vm:AppointmentsViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Grid>
                    <TextBlock Text="{Binding CurrentService.Name}"/>
                    <TextBlock HorizontalAlignment="Right">
                    <Run Text="{Binding CurrentMaster.FirstName}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CurrentMaster.LastName}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CurrentMaster.Patronymic}"/>
                    </TextBlock>
                </Grid>
            </Border>
            
            <ListBox Grid.Row="1" ItemsSource="{Binding MSAppointments}" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Path=Date, StringFormat='dd.MM.yyyy'}"/>
                            <TextBlock Text="{Binding Path=Hour, StringFormat='00'}"/>
                            <TextBlock Text="{Binding Path=Minute, StringFormat='00'}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </Grid>
</Page>
