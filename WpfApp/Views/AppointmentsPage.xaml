<Page x:Class="WpfApp.Views.AppointmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Views"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Title="AppointmentsPage">

    
    <Page.DataContext>
        <vm:AppointmentsViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Calendar SelectedDate="{Binding SelectedDT}"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Grid>
                    <TextBlock Text="{Binding CurrentService.Name}"/>
                    <TextBlock HorizontalAlignment="Right">
                    <Run Text="{Binding CurrentMaster.FirstName}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CurrentMaster.LastName}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding CurrentMaster.Patronymic}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="1" 
                Visibility="{Binding MSAppointments,
                Converter={StaticResource EmptyCollectionToVisibility}}">
                <TextBlock Text="Записей на это число нет!"/>
            </Border>

            <ListBox Validation.ErrorTemplate="{x:Null}" 
                     Grid.Row="1" x:Name="AppListBox"
                     SelectedItem="{Binding SelectedAppointment}"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ItemsSource="{Binding MSAppointments}" 
                     d:ItemsSource="{d:SampleData ItemCount=5}"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="152" Height="50" 
                                CornerRadius="5" Background="LightGray"
                                Padding="5"  Margin="2, 2, 2, 8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock TextAlignment="Center"
                                           Text="{Binding Path=Date, StringFormat='dd.MM.yyyy'}"/>
                                <TextBlock TextAlignment="Center" FontSize="16">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:00}:{1:00}">
                                            <Binding Path="Hour" />
                                            <Binding Path="Minute" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel  Width="500"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </Grid>
</Page>
