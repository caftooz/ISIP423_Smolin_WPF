<Window x:Class="WpfApp.Views.ServiceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Услуга" Height="280" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock Text="Название"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,8"/>

        <TextBlock Text="Тип услуги"/>
        <ComboBox x:Name="TypeCombo" DisplayMemberPath="Name" Margin="0,0,0,8"/>

        <TextBlock Text="Цена"/>
        <TextBox x:Name="PriceBox" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="80" Margin="0,0,5,0" Click="Cancel_Click"/>
            <Button Content="Сохранить" Width="80" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
