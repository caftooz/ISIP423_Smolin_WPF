<Page x:Class="WpfApp.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      Title="AdminPage">
    <Page.DataContext>
        <vm:AdminViewModel/>
    </Page.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Header}">
            <Grid>
                <TextBlock Style="{StaticResource SubtitleText}" VerticalAlignment="Center">
                    <Run Text="{Binding CurrentUser.LastName, Mode=OneWay}"/>
                    <Run Text=" "/><Run Text="{Binding CurrentUser.FirstName, Mode=OneWay}"/>
                    <Run Text=" "/><Run Text="{Binding CurrentUser.Patronymic, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,18,0,0"
                           Text="{Binding CurrentUser.PhoneNumber}"/>
                <Button Content="Выйти из аккаунта" Style="{StaticResource MainButton}"
                        HorizontalAlignment="Right" Command="{Binding LogoutCommand}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,10,20,0">
            <TextBox Style="{StaticResource MainTextBox}" Width="300" Margin="0,0,8,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="+" Style="{StaticResource AccentButton}" Padding="10,6"
                    FontSize="16" FontWeight="Bold" Command="{Binding AddCommand}"/>
        </StackPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding Users}" Style="{StaticResource MainListBox}"
                 Margin="20,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Width="500">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                                    <Run Text="{Binding LastName, Mode=OneWay}"/>
                                    <Run Text=" "/><Run Text="{Binding FirstName, Mode=OneWay}"/>
                                    <Run Text=" "/><Run Text="{Binding Patronymic, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding PhoneNumber}"/>
                                <TextBlock Style="{StaticResource CaptionText}">
                                    <Run Text="Роль: "/><Run Text="{Binding UserRoles.Name, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✏" Style="{StaticResource IconButton}"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
