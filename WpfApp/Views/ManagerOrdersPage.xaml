<Page x:Class="WpfApp.Views.ManagerOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      Title="ManagerOrdersPage">
    <Page.DataContext>
        <vm:ManagerOrdersViewModel/>
    </Page.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200"
                 HorizontalAlignment="Left" Margin="0,0,0,8"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDateTime, StringFormat='dd.MM.yyyy'}" Width="90"/>
                <DataGridTextColumn Header="Время" Width="60">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0:00}:{1:00}">
                            <Binding Path="OrderDateTime.Hour"/>
                            <Binding Path="OrderDateTime.Minute"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Users.LastName}" Width="100"/>
                <DataGridTextColumn Header="Товары" Width="180">
                    <DataGridTextColumn.Binding>
                        <Binding Path="OrderProducts" Converter="{StaticResource OrderProductsToStringConverter}"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalCost, StringFormat={}{0:0.00} ₽}" Width="90"/>
                <DataGridTextColumn Header="Статус" Width="80">
                    <DataGridTextColumn.Binding>
                        <Binding Path="IsCompleted" Converter="{StaticResource BoolToStatusConverter}"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Действия" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="выдать" Margin="2"
                                    Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
