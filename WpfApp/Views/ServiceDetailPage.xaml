<Page x:Class="WpfApp.Views.ServiceDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Views"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Title="ServiceDetailPage">

    <Page.DataContext>
        <vm:ServiceDetailViewModel/>
    </Page.DataContext>
    
    <Grid>
        <ScrollViewer>
            <StackPanel>
                <Grid VerticalAlignment="Top" Height="200">
                    <Image Source="{Binding CurrentService.ServiceTypes.Image}"
                           Stretch="UniformToFill"/>
                    <Border Height="150" Width="200" Background="White"
                            Opacity="0.7"
                            BorderThickness="2" BorderBrush="Black"
                            Margin="-200,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentService.Name}"/>
                            <TextBlock TextWrapping="Wrap"
                                Text="{Binding CurrentService.Description}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <ListBox Validation.ErrorTemplate="{x:Null}" 
                         x:Name="LListBox"
                         Background="Transparent" BorderThickness="0"
                         HorizontalAlignment="Center"
                         ItemsSource="{Binding ServiceMasters}" d:ItemsSource="{d:SampleData ItemCount=5}"
                         SelectedItem="{Binding SelectedMaster}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black"
                                    BorderThickness="2">
                                <Grid Width="400">
                                    <TextBlock>
                                    <Run Text="{Binding Path=FirstName}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Path=LastName}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Path=Patronymic}"/>
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Right"
                                           Text="->"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
