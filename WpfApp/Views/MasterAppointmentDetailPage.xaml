<Page x:Class="WpfApp.Views.MasterAppointmentDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      Title="MasterAppointmentDetailPage">
    <Page.DataContext>
        <vm:MasterAppointmentDetailViewModel/>
    </Page.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Header}">
            <Grid>
                <TextBlock Style="{StaticResource SubtitleText}" VerticalAlignment="Center">
                    <Run Text="{Binding CurrentUser.LastName, Mode=OneWay}"/>
                    <Run Text=" "/><Run Text="{Binding CurrentUser.FirstName, Mode=OneWay}"/>
                    <Run Text=" "/><Run Text="{Binding CurrentUser.Patronymic, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,18,0,0"
                           Text="{Binding CurrentUser.PhoneNumber}"/>
                <Button Content="Выйти из аккаунта" Style="{StaticResource MainButton}"
                        HorizontalAlignment="Right" Command="{Binding LogoutCommand}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <Button Content="Назад" Style="{StaticResource MainButton}" HorizontalAlignment="Left"
                    Command="{Binding BackCommand}"/>

            <Border Style="{StaticResource CardBorder}" Width="380" Margin="0,10,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="{Binding Appointment.Services.Name}"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,15">
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="{Binding Appointment.AppointmentDateTime, StringFormat='dd.MM.yyyy'}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource BodyText}" HorizontalAlignment="Right">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:00}:{1:00}">
                                    <Binding Path="Appointment.AppointmentDateTime.Hour"/>
                                    <Binding Path="Appointment.AppointmentDateTime.Minute"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>

                    <TextBlock Style="{StaticResource LabelText}" Text="клиент"/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8">
                        <Run Text="{Binding Appointment.Users.LastName, Mode=OneWay}"/>
                        <Run Text=" "/><Run Text="{Binding Appointment.Users.FirstName, Mode=OneWay}"/>
                        <Run Text=" "/><Run Text="{Binding Appointment.Users.Patronymic, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Style="{StaticResource LabelText}" Text="телефон клиента"/>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Appointment.Users.PhoneNumber}"
                               Margin="0,0,0,15"/>

                    <Button Content="Завершить" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Center" Padding="30,8"
                            Command="{Binding CompleteCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
