<Window x:Class="WpfApp.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        Title="Пользователь" Height="380" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:UserEditViewModel/>
    </Window.DataContext>
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource LabelText}" Text="ФИО"/>
        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding FullName}" Margin="0,0,0,8"/>

        <TextBlock Style="{StaticResource LabelText}" Text="Телефон"/>
        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding Phone}" Margin="0,0,0,8"/>

        <TextBlock Style="{StaticResource LabelText}" Text="Пароль"/>
        <TextBox Style="{StaticResource MainTextBox}" Text="{Binding Password}" Margin="0,0,0,8"/>

        <TextBlock Style="{StaticResource LabelText}" Text="Роль"/>
        <ComboBox Style="{StaticResource MainComboBox}" ItemsSource="{Binding Roles}"
                  SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Style="{StaticResource BodyText}" Text="Статус" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsNotFrozen}"/>
            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock.Text>
                    <Binding Path="IsNotFrozen" Converter="{StaticResource BoolToFrozenConverter}"/>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>

        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Отмена" Style="{StaticResource MainButton}" Command="{Binding CancelCommand}"/>
            <Button Content="Сохранить" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
