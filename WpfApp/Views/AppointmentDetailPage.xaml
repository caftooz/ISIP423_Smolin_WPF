<Page x:Class="WpfApp.Views.AppointmentDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:WpfApp.ViewModels"
      Title="AppointmentDetailPage">
    <Page.DataContext><vm:AppointmentDetailViewModel/></Page.DataContext>
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Назад" Style="{StaticResource MainButton}" HorizontalAlignment="Left"
                    Command="{Binding BackCommand}"/>

            <Border Style="{StaticResource FormBorder}" Width="340" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="{Binding MasterService.Services.Name}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource BodyText}">
                        <Run Text="{Binding MasterService.Users.LastName, Mode=OneWay}"/>
                        <Run Text=" "/><Run Text="{Binding MasterService.Users.FirstName, Mode=OneWay}"/>
                        <Run Text=" "/><Run Text="{Binding MasterService.Users.Patronymic, Mode=OneWay}"/>
                    </TextBlock>
                    <Grid Margin="0,8,0,10">
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding DateTime.Date, StringFormat='dd.MM.yyyy'}"/>
                        <TextBlock Style="{StaticResource BodyText}" HorizontalAlignment="Right">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:00}:{1:00}">
                                    <Binding Path="DateTime.Hour"/><Binding Path="DateTime.Minute"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>

                    <TextBlock Style="{StaticResource LabelText}" Text="Способ оплаты"/>
                    <ComboBox Style="{StaticResource MainComboBox}" ItemsSource="{Binding PaymentMethods}"
                              SelectedItem="{Binding SelectedPaymentMethod}" Margin="0,0,0,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Path=Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Style="{StaticResource LabelText}" Text="Комментарий"/>
                    <TextBox Style="{StaticResource MainTextBox}" Text="{Binding Comment}" Margin="0,0,0,12"/>

                    <Button Content="Записаться" Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                            Padding="30,8" Command="{Binding MakeAnAppointment}"/>

                    <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
