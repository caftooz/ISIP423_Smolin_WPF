<Window x:Class="WpfApp.Views.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        Title="ProductDetailWindow" Width="540" MinHeight="300"
        SizeToContent="Height" MaxHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.DataContext><vm:ProductDetailViewModel/></Window.DataContext>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Source="{Binding Product.Image}" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Top"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Info -->
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Product.Name}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Product.ManufacturerName}"/>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Product.Rating, StringFormat=Рейтинг: {0:0.0}}" Margin="0,4,0,4"/>
                <TextBlock Style="{StaticResource PriceText}" Text="{Binding Product.FinalPrice, StringFormat={}{0:0.00} ₽}"/>
                <TextBlock Style="{StaticResource OldPriceText}" Text="{Binding Product.Price, StringFormat={}{0:0.00} ₽}"
                           Visibility="{Binding Product.ShowDiscount, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Product.PercentageDiscount, StringFormat=скидка {0}%}"
                           Visibility="{Binding Product.ShowDiscount, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Description (scrollable) -->
            <ScrollViewer Grid.Row="1" Margin="0,8,0,8" VerticalScrollBarVisibility="Auto">
                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Text="{Binding Product.Description}"/>
            </ScrollViewer>

            <!-- Cart buttons (always at bottom) -->
            <StackPanel Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding ShowQuantity, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="−" Style="{StaticResource IconButton}" Command="{Binding DecreaseCountCommand}"/>
                    <TextBlock Style="{StaticResource SubtitleText}" Text="{Binding QuantityInCart}" Margin="12,0" VerticalAlignment="Center"/>
                    <Button Content="+" Style="{StaticResource IconButton}" Command="{Binding IncreaseCountCommand}"/>
                </StackPanel>
                <Button Content="В корзину" Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                        Visibility="{Binding ShowQuantity, Converter={StaticResource InverseBoolToVisibility}}"
                        Command="{Binding ToCartCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
