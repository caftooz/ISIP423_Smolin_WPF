<Window x:Class="WpfApp.Views.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Views"
        xmlns:vm="clr-namespace:WpfApp.ViewModels"
        mc:Ignorable="d"
        Title="ProductDetailWindow" Height="300" Width="500">

    <Window.DataContext>
        <vm:ProductDetailViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Source="{Binding Product.Image}" Margin="10"/>
        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Product.Name}"/>
            <TextBlock Text="{Binding Product.ManufacturerName}"/>
            <TextBlock Text="{Binding Product.Rating, StringFormat={}{0:0.0}!}"/>

            <TextBlock Text="{Binding Product.FinalPrice}"/>
            <TextBlock Text="{Binding Product.Price}"
                                                   Visibility="{Binding Product.ShowDiscount, 
                                            Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding Product.PercentageDiscount, StringFormat={}{0}%}"
                                                   Visibility="{Binding Product.ShowDiscount, 
                                            Converter={StaticResource BoolToVisibility}}"/>

            <TextBlock Text="{Binding Product.Description}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Visibility="{Binding ShowQuantity,
                Converter={StaticResource BoolToVisibility}}">
                <Button Content="-" Command="{Binding DecreaseCountCommand}"/>
                <TextBlock Text="{Binding QuantityInCart}" Margin="10"/>
                <Button Content="+" Command="{Binding IncreaseCountCommand}"/>
            </StackPanel>
            
            <Button Visibility="{Binding ShowQuantity, Converter={StaticResource InverseBoolToVisibility}}"
                Content="В корзину" Command="{Binding ToCartCommand}"/>
        </StackPanel>
    </Grid>
</Window>
