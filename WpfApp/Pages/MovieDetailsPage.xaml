<Page x:Class="WpfApp.Pages.MovieDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      Language="ru-RU"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Информация о фильме">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Source="{Binding PosterPath}" Stretch="Uniform" VerticalAlignment="Top"/>

        <StackPanel Grid.Column="1" Margin="30,0,0,0">
            <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
            <ListBox ItemsSource="{Binding Genres}" Margin="0,10,0,10"
                     Background="Transparent" 
                     BorderThickness="0" IsHitTestVisible="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="DarkGray" CornerRadius="5"
                                Padding="5">
                            <TextBlock Text="{Binding Name}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Width="Auto"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="★ " Foreground="#ea8c2c" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Rating}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Background="#AA000000" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="5" Margin="5" CornerRadius="4">
                    <TextBlock Text="{Binding AgeRatings.Age, StringFormat='{}{0}+'}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
            </StackPanel>

            <TextBlock Text="Описание" Style="{StaticResource HeaderTitle}"/>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="16" LineHeight="22"/>

            <TextBlock Text="Выберите сеанс" FontSize="20" FontWeight="Bold" Margin="0,30,0,10"/>
            <ListBox x:Name="SessionsList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Session_Click" Margin="0,5" Padding="15,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StartTime, StringFormat='dd MMM, HH:mm'}" Width="150"/>
                                <TextBlock Text="{Binding Halls.Name}" Foreground="Gray" Width="100"/>
                                <TextBlock Text="{Binding Halls.Classifications.Name}" FontWeight="Bold" Width="80"/>
                                <TextBlock Text="{Binding Price, StringFormat='{}{0} руб.'}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
