<Page x:Class="WpfApp.Pages.SeatSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Выбор места">

    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="ЭКРАН" HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,40" FontSize="20"/>

            <ItemsControl x:Name="SeatsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="SeatsGrid" Columns="15" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource SeatStyle}" 
                                  IsChecked="{Binding IsSelected}"
                                  IsEnabled="{Binding IsAvailable}"
                                  Content="{Binding Number}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30">
                <Button Content="Убрать занятые" Margin="10" Padding="10"/>
                <Button x:Name="ConfirmBtn" Content="Оформить билет"
                        Background="#E50914" Foreground="White" Padding="20,10" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
