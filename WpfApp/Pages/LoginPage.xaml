<Page x:Class="WpfApp.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Вход">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Width="300">
            <TextBlock Text="ВХОД" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин" Style="{StaticResource HeaderTitle}"/>
            <TextBox x:Name="LoginBox" Margin="0,5,0,15" Height="35" VerticalContentAlignment="Center"/>

            <TextBlock Text="Пароль" Style="{StaticResource HeaderTitle}"/>
            <PasswordBox x:Name="PassBox" Margin="0,5,0,25" Height="35" VerticalContentAlignment="Center"/>

            <!-- Captcha panel, hidden by default -->
            <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed" Margin="0,0,0,15">
                <TextBlock Text="Введите символы с картинки:" FontSize="12" Margin="0,0,0,5"/>
                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,5">
                    <Grid>
                        <Canvas x:Name="CaptchaCanvas" Height="50"/>
                        <Button Content="↻" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="25" Height="25" Margin="0,2,2,0" FontSize="14"
                                Background="Transparent" BorderThickness="0"
                                Click="RefreshCaptcha_Click" ToolTip="Обновить капчу"/>
                    </Grid>
                </Border>
                <TextBox x:Name="CaptchaInputBox" Height="30" VerticalContentAlignment="Center"
                         FontSize="14" MaxLength="5"/>
            </StackPanel>

            <Button Content="Войти" Height="40" Click="LoginButton_Click"/>
            <Button Content="Нет аккаунта? Регистрация" Margin="0,15,0,0" Background="Transparent"
                    BorderThickness="0" Foreground="Gray" Click="ToRegButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
