<Page x:Class="WpfApp.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      Language="ru-RU"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderThickness="2" CornerRadius="350"
                Height="350" VerticalAlignment="Top">
            <Border.Background>
                <ImageBrush ImageSource="/Images/Profile.jpg" Stretch="Fill" />
            </Border.Background>
        </Border>
        <StackPanel Grid.Column="1" Margin="30,0,0,0">
            <TextBlock Text="Профиль" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
            <StackPanel Orientation="Vertical" Margin="0,10">
                <TextBlock Text="{Binding Email, StringFormat=Почта: {0}}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Login, StringFormat=Логин: {0}}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Билеты:" FontSize="18" FontWeight="Bold"/>
            <ListBox x:Name="TicketsListBox" Background="Transparent" 
                     BorderThickness="0" IsHitTestVisible="False">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Padding="6,2,6,2" CornerRadius="4" 
                                Background="LightGray" BorderThickness="2"
                                BorderBrush="Gray" Width="600">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Sessions.Movies.Title}" FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           FontSize="18"/>
                                <Grid>
                                    <TextBlock x:Name="HallInfo">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Seats.Halls.Name" />
                                                <Binding Path="Seats.Halls.Classifications.Name" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <TextBlock Text="{Binding Sessions.StartTime, StringFormat='{}{0:d MMMM yyyy, HH:mm}'}"
                                               HorizontalAlignment="Right"/>

                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Seats.Row, StringFormat='Ряд: {0}, '}"/>
                                    <TextBlock Text="{Binding Seats.Number, StringFormat='Место: {0}'}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
