<Page x:Class="WpfApp.Pages.PartSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      Language="ru-RU"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Выбор комплектующего">

    <Grid Background="#F5F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="LightGray"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <Button Content="← Назад" Click="BtnBack_Click" 
                        Padding="15,5" Background="Transparent" BorderBrush="#34495E" Foreground="#34495E"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#7F8C8D"/>
                    <TextBox x:Name="TbSearch" Width="300" Padding="5" TextChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Производитель:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#7F8C8D"/>
                    <ComboBox x:Name="CbManufacturer" Width="150" SelectionChanged="FilterChanged" DisplayMemberPath="name"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ListView x:Name="LvParts" Background="Transparent" BorderThickness="0" 
                      HorizontalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="260" Height="380" Background="White" CornerRadius="10" Margin="10" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#E0E0E0"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Source="{Binding image}" Stretch="Uniform" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Text="{Binding name}" FontWeight="Bold" FontSize="16" 
                           TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="2" Text="{Binding manufacturer$.name}" Foreground="#7F8C8D" Margin="0,5"/>

                                <StackPanel Grid.Row="3">
                                    <TextBlock Text="{Binding price, StringFormat={}{0:N2} ₽}" 
                               FontSize="20" FontWeight="Black" Foreground="#27AE60" Margin="0,0,0,10"/>
                                    <Button Content="Добавить в сборку" Background="#2980B9" Foreground="White" 
                            Padding="10" Click="BtnSelect_Click" Tag="{Binding id}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>
